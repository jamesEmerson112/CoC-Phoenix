# Copy to .env (or export these) before `cargo run`.
# Matches the credentials in docker-compose.yml.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/coc_phoenix

# Where the HTTP server listens.
BIND_ADDR=127.0.0.1:8080

# Connection pool size.
DB_MAX_CONNECTIONS=5

# Which bundled content pack to serve.
CONTENT_PACK_ID=starter-modern

# Set to false to skip running migrations on boot.
RUN_MIGRATIONS=true

# Set to false to skip republishing content/starter_pack.json on boot. Leave it on: content is
# data, not schema, and this upsert is how a content edit reaches an existing database.
SYNC_CONTENT=true

# Log filter (tracing-subscriber EnvFilter syntax).
RUST_LOG=info,tower_http=debug
